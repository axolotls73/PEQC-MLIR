#!/bin/sh

## Project: docker-ubuntu-xilinx-dev
## File: container/bin/docker-ubuntu-peqc-mlir-command
## License: none, closed source, exclusive rights to the author.
## Written by Louis-Noel Pouchet <pouchet@colostate.edu>, 2022. All rights reserved.
## Copyright (c) Louis-Noel Pouchet, 2022.

## Resolve script directory; the config below uses $scriptdir for paths
## like MOUNTS_VOLUME_FILENAME.
scriptdir=`dirname "$0"`;
scriptdir=`cd "$scriptdir" && pwd`;
scriptname=`basename $0`;

## Default config file.
if [ -z "$CLI_CONFIG_FILE" ]; then 
    CLI_CONFIG_FILE="$scriptdir/configs/config.dockergen-peqc-mlir-2025-llvm21-command.txt";
fi;

## Load option parser, config file loader, mount file loader
CONTAINER_COMMON_FILE="$scriptdir/container-common.sh";
. "$CONTAINER_COMMON_FILE";

if [ "x$1" = "x-v" ]; then
    VERBOSE_OUTPUT="true";
    shift;
else
    VERBOSE_OUTPUT="false";
fi;


## Parse options.
parse_command_options;


echo_verbose()
{
    msg="$1";
    if [ "$VERBOSE_OUTPUT" = "true" ]; then
	echo "$msg";
    fi;
}

echo_verbose "[INFO] $0 written by Louis-Noel Pouchet, 2022, all rights reserved.";


## Load configuration file
load_config_file


if [ -z "$CONTAINER_NAME_PREFIX" ]; then
    CONTAINER_NAME_PREFIX="$IMAGE_NAME-dev-$USER-command-noninteractive-dockerallocatedcpus-";
fi;

echo_verbose "[INFO] Run $@ in $IMAGE_NAME image with a non-interactive container (automatically killed/removed on exit).";

ALL_ARGS="$@";
CUR_DIR=`pwd`;

## Get currently running non-interactive containers by all users:
list_containers=`$SUDO_CMD docker ps --format '{{.Names}}' | grep ".*-dockerallocatedcpus-.*"`;
## Get list of currently used cpu core ids by the current user:
is_used_by_user=`echo "$list_containers" | grep "$CONTAINER_NAME_PREFIX" | sed -e 's/.*-dockerallocatedcpus-\(.*\)/\1/g' | sed -e 's/-/\n/g' | uniq | wc -l`;
if [ -z "$is_used_by_user" ]; then
	is_used_by_user=0;
fi;
is_requested_by_user=$(($is_used_by_user+$NB_CPUS_PER_CONTAINER));
if [ "$is_requested_by_user" -gt "$MAX_CPUS_PER_USER" ]; then
	echo "[ERROR] Insufficient resources: user is allocated $MAX_CPUS_PER_USER, and $is_used_by_user in use ($$NB_CPUS_PER_CONTAINER additional cores requested). Abort.";
	exit 101;
fi;

CPU_SET="";
## Find available cpus.
nb_avail_cpus_found=0;
max_nb_cpus=$(($MAX_CPUS_TOTAL-1));
if [ "$CPU_TOPO_IS_ODD_EVEN" = "true" ]; then
	max_nb_cpus=$(($MAX_CPUS_TOTAL*2-1));
fi;
for i in `seq 0 $max_nb_cpus`; do
    if [ "$CPU_TOPO_IS_ODD_EVEN" = "true" ]; then
	is_odd=`expr $i % 2`;
	if [ "$is_odd" -eq 1 ]; then
	    continue;
	fi;
    fi;
    ## Check if processor core id $i is in use in some container:
    proc_list=`echo "$list_containers" | sed -e 's/.*-dockerallocatedcpus-\(.*\)/\1/g' | grep "^$i$\|^$i-\|-$i-\|-$i$"`;
    if [ -z "$proc_list" ]; then
    	## It is not. Allocate it to this container.
	if [ -z "$CPU_SET" ]; then
	    CPU_SET="$i";
	    CPU_ID="$i";
	else
	    CPU_SET="$CPU_SET,$i";
	fi;
	nb_avail_cpus_found=$(($nb_avail_cpus_found+1));
	if [ "$nb_avail_cpus_found" -eq "$NB_CPUS_PER_CONTAINER" ]; then
	    break;
	fi;
    fi;
done;

## Ensure there are enough CPUs left to run the container.
if [ "$nb_avail_cpus_found" -lt "$NB_CPUS_PER_CONTAINER" ]; then
    echo "[ERROR] Not enough CPUs available to run. Available for the user: $MAX_CPUS_PER_USER, set of available processor ids for this run: $CPU_SET, requested number of processors: $NB_CPUS_PER_CONTAINER. Limit exceeded, resource request cannot be served. Abort.";
    exit 101;
fi;

CPU_LIST=`echo "$CPU_SET" | sed -e 's/,/-/g'`;
CONTAINER_NAME="$CONTAINER_NAME_PREFIX$CPU_LIST";
CONTAINER_HOSTNAME="ubuntu-xilinx-dev-$USER-00$CPU_ID-noninteractive";

## Load mounts for the container from volumes.
load_mount_volumes_list

if ! [ -z "$SUDO_CMD" ]; then
    echo_verbose "[WARNING] This script uses the $SUDO_CMD docker ... commands, you may be \
prompted for your root password.";
fi;
echo_verbose "[WARNING] This script assumes the file(s) passed as argument are in the current directory, or a subdirectory of it AND NOT IN A PARENT DIRECTORY.";
echo_verbose "[INFO] DockerGen command docker container:";
echo_verbose "[INFO] container name: $CONTAINER_NAME";
echo_verbose "[INFO] Resources: CPUs list $CPU_SET, CPUs-equivalent scheduling shares $CPU_SHARES, RAM size $RAM_SIZE";


CD_CURDIR="";
if [ "x$MOUNT_HOST_CURRENT_DIR" = "xtrue" ]; then
    MOUNT_HOST_CURRENT_DIR="-v $CUR_DIR:/mountedhostdata$CUR_DIR";
    CD_CURDIR="cd /mountedhostdata$CUR_DIR && ";
else
    MOUNT_HOST_CURRENT_DIR="";
fi;

if ! [ -z "$RUN_COMMAND_BEFORE_MAIN_COMMAND" ]; then
    RUN_COMMAND_BEFORE_MAIN_COMMAND="$RUN_COMMAND_BEFORE_MAIN_COMMAND && ";
fi;

if [ -z "$ALL_ARGS" ]; then echo "[ERROR] Empty command."; exit 1; fi;
timeout $TIMEOUT_RUN $SUDO_CMD docker run --rm --cpuset-cpus="$CPU_SET" --cpus="$CPU_SHARES" --memory="$RAM_SIZE" --memory-reservation="8g" --net=host -e DISPLAY -h "$CONTAINER_HOSTNAME" $MOUNT_VOLUMES_LIST $MOUNT_HOST_CURRENT_DIR --name "$CONTAINER_NAME" "$IMAGE_NAME" $LAUNCHER_SHELL -lc "echo '================================================================================'; $CD_CURDIR $RUN_COMMAND_BEFORE_MAIN_COMMAND $RUN_COMMAND_PREFIX $ALL_ARGS";
ret=$?;
echo_verbose "[INFO] All done executing Docker/$IMAGE_NAME: $@";
exit $ret;
