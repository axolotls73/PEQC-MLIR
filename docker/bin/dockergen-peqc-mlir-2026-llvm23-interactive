#!/bin/sh

## Project: dockergen
## File: container/run-container-interactive.sh
## License: none, closed source, exclusive rights to the author.
## Written by Louis-Noel Pouchet <pouchet@colostate.edu>, 2022. All rights reserved.
## Copyright (c) Louis-Noel Pouchet, 2022.
# echo "[INFO] $0 written by Louis-Noel Pouchet, copyright (c) 2022, all rights reserved.";

## Resolve script directory; the config below uses $scriptdir for paths
## like MOUNTS_VOLUME_FILENAME.
scriptdir=`dirname "$0"`;
scriptdir=`cd "$scriptdir" && pwd`;
scriptname=`basename $0`;

## Default config file.
if [ -z "$CLI_CONFIG_FILE" ]; then
    CLI_CONFIG_FILE="$scriptdir/configs/config.dockergen-peqc-mlir-2026-llvm23-interactive.txt";
fi;

## Load option parser, config file loader, mount file loader 
CONTAINER_COMMON_FILE="$scriptdir/container-common.sh";
. "$CONTAINER_COMMON_FILE";

## Parse options.
parse_command_options;

## Set to a unique id for the container to start/access.
if ! [ -z "$1" ]; then
    CONTAINER_INSTANCE_NUMBER=$1;
fi;
if [ -z "$CONTAINER_INSTANCE_NUMBER" ]; then
    CONTAINER_INSTANCE_NUMBER=1;
fi;

## Load configuration file
load_config_file
    
if [ -z "$CONTAINER_NAME" ]; then
    CONTAINER_NAME="$IMAGE_NAME-dev-container-$USER-$CONTAINER_INSTANCE_NUMBER";
fi;
    
if [ -z "$CONTAINER_HOSTNAME" ]; then
    CONTAINER_HOSTNAME="$IMAGE_NAME-dev-$USER-00$CONTAINER_INSTANCE_NUMBER";
fi;

if ! [ -z "$SUDO_CMD" ]; then
    $echo_cmd "$orange_color[WARNING] This script uses the sudo docker ... commands, you may be \
prompted for your root password.$no_color";
fi;

if ! [ -z "$CONTAINER_MAC_ADDRESS" ]; then
    $echo_cmd "$orange_color[WARNING] Override container MAC address to $CONTAINER_MAC_ADDRESS$no_color";
    CONTAINER_MAC_ADDRESS="--mac-address $CONTAINER_MAC_ADDRESS";
    $echo_cmd "$orange_color[WARNING] This may cause unexpected network behavior if other containers / other users are running this script!$no_color";
fi;

## Configure xauth and DISPLAY variables.
configure_xauth_display;


echo "[INFO] Running/connecting to container now.";
## Check if container already running.
v=`$SUDO_CMD docker ps |grep "$CONTAINER_NAME"`;
if ! [ -z "$v" ]; then
	echo "[INFO] Container $CONTAINER_NAME (image=$IMAGE_NAME) already running.";
else

    MOUNT_X11_SOCKET="";
    if [ -d "/tmp/.X11-unix" ]; then
	MOUNT_X11_SOCKET="-v /tmp/.X11-unix:/tmp/.X11-unix:rw";
	echo "[INFO] Mount X11 socket: $MOUNT_X11_SOCKET";
    else
	$echo_cmd "$orange_color[WARNING] No X11 socket available to mount, X11 will not work!$no_color";
    fi;
    ## Account home directory. for root here.
    if ! [ -z "$LOGIN_AS_USER" ]; then
	TGT_USERHOME="/home/$USER";
	USER_UID=`id -u`;
	USER_GID=`id -g`;
	USERLOGIN="--user $USER_UID:$USER_GID";
	CONTAINER_PRIVILEGED="--privileged";
    else
	TGT_USERHOME="/root";
	USERLOGIN="";
	CONTAINER_PRIVILEGED="--privileged";
    fi;

    if ! [ -z "$XAUTHORITYLOCATION" ]; then 
	MOUNT_X11_SOCKET="$MOUNT_X11_SOCKET -v $XAUTHORITYLOCATION:$TGT_USERHOME/.Xauthority";
    fi;

    ## Load mounts for the container from volumes.
    load_mount_volumes_list

    delete_container="";
    if ! [ -z "$DELETE_CONTAINER_AT_EXIT" ]; then
	delete_container="--rm";
    fi
    $MOUNT_DATA_HOST_SHARE="";
    if [ -d "$scriptdir/../data-host-share" ]; then
	has_data_host_share=`echo "$MOUNT_VOLUMES_LIST" | grep ":/data-host-share"`;
	if [ -z "$has_data_host_share" ]; then
	    MOUNT_DATA_HOST_SHARE="-v $scriptdir/../data-host-share:/data-host-share";
	else
	    MOUNT_DATA_HOST_SHARE="";
	fi;
    fi;

    if [ "x$MOUNT_HOST_CURRENT_DIR" = "xtrue" ]; then
	CUR_DIR=`pwd`;
	MOUNT_HOST_CURRENT_DIR="-v $CUR_DIR:/mountedhostdata$CUR_DIR";
    else
	MOUNT_HOST_CURRENT_DIR="";
    fi;
    
    $SUDO_CMD docker run $delete_container -it $CONTAINER_MAC_ADDRESS $CONTAINER_PRIVILEGED -d -e DISPLAY=$DISPLAY \
    -h "$CONTAINER_HOSTNAME" $USERLOGIN \
    --workdir="$TGT_USERHOME" \
    $MOUNT_VOLUMES_LIST \
    $MOUNT_X11_SOCKET \
    $MOUNT_DATA_HOST_SHARE \
    $MOUNT_HOST_CURRENT_DIR \
    --name "$CONTAINER_NAME" "$IMAGE_NAME";
    res="$?";
    if [ "$res" -eq 0 ]; then
	echo "[INFO] Container $CONTAINER_NAME (image=$IMAGE_NAME) started.";
    else
	$echo_cmd "$red_color[ERROR] Could not start container $CONTAINER_NAME from image $IMAGE_NAME$no_color";
	exit "$res";
    fi;
fi;
echo "[INFO] Container $CONTAINER_NAME (image=$IMAGE_NAME) mounts:
   $scriptdir/../data-host-share to vm:/data-host-share
   $MOUNT_VOLUMES_LIST"
if ! [ -z "$USE_GRAPHICAL_DISPLAY" ]; then  
echo "   $XAUTHORITYLOCATION to vm:/root/.Xauthority:rw";
fi;

echo "[INFO] Connecting to $CONTAINER_NAME via interactive bash session:";
$SUDO_CMD docker exec -it $CONTAINER_PRIVILEGED "$CONTAINER_NAME" sh -lc "/bin/bash";
$echo_cmd "[INFO] To kill container definitively:$SUDO_CMD docker rm -f $CONTAINER_NAME";
$echo_cmd "$green_color[INFO] Exited container $CONTAINER_NAME (still runnnig).$no_color";
